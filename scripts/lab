#!/usr/bin/env bash
# Command line entry point for the lab: VM commands (via make) and base image commands.
set -euo pipefail

root=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
cd "$root"

usage() {
  cat <<'USAGE'
usage: lab <command> [args]

  up [limit]                  create VMs and wait until they accept connections
  provision [limit] [args]    run playbooks/main.yml
  stop <limit> [--force]      shut VMs down
  destroy <limit>             delete VMs and their disks
  status                      list lab VMs
  image list                  list base images in lab-base
  image build [--force] [name ...]
                              download Linux images (images/manifest.yml) and build Windows
                              images (images/windows.yml); default all, skips images that
                              exist, --force rebuilds Windows images
  image prune [--delete]      list (or delete) old base images no disk uses

limit is any Ansible limit pattern: a group, host1,host2, or a pattern (default: all).
USAGE
}

cmd=${1:-}
[ $# -eq 0 ] || shift

case $cmd in
  up) exec make up LIMIT="${1:-all}" ;;
  provision)
    limit=${1:-all}
    [ $# -eq 0 ] || shift
    exec make provision LIMIT="$limit" ANSIBLE_EXTRA_ARGS="$*"
    ;;
  stop)
    limit=${1:?stop needs a limit, for example: lab stop ubuntu2204-sql2022}
    shift
    case ${1:-} in
      "") exec make stop LIMIT="$limit" ;;
      --force) exec make stop LIMIT="$limit" FORCE=1 ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  destroy) exec make destroy LIMIT="${1:?destroy needs a limit, for example: lab destroy ubuntu2204-sql2022}" ;;
  status) exec make status ;;
  image)
    sub=${1:-}
    [ $# -eq 0 ] || shift
    case $sub in
      list) exec virsh -c qemu:///system vol-list --pool "${LAB_BASE_POOL:-lab-base}" ;;
      build)
        force=0
        names=()
        for arg in "$@"; do
          if [ "$arg" = --force ]; then force=1; else names+=("$arg"); fi
        done
        known=$(python3 -I - images/manifest.yml images/windows.yml <<'PY'
import sys, yaml
for kind, path in (("linux", sys.argv[1]), ("windows", sys.argv[2])):
    for key in yaml.safe_load(open(path))["images"]:
        print(kind, key)
PY
)
        [ ${#names[@]} -gt 0 ] || mapfile -t names < <(awk '{print $2}' <<<"$known")
        for name in "${names[@]}"; do
          kind=$(awk -v n="$name" '$2 == n {print $1}' <<<"$known")
          case $kind in
            linux) scripts/image-build-linux.sh "$name" ;;
            windows)
              if [ "$force" = 0 ] && virsh -c qemu:///system vol-list --pool "${LAB_BASE_POOL:-lab-base}" --details 2>/dev/null \
                | awk '{print $1}' | grep -Eq "^$name-[0-9]{12}\.qcow2$"; then
                echo "$name: already in lab-base (--force rebuilds)"
              else
                scripts/image-build-windows.sh "$name"
              fi
              ;;
            *) echo "unknown image: $name" >&2; exit 2 ;;
          esac
        done
        ;;
      prune) exec scripts/image-prune.sh "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
