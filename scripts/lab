#!/usr/bin/env bash
# Command line entry point for the lab: VM commands and base image commands.
set -euo pipefail

root=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
cd "$root"
export PATH=$root/.venv/bin:$PATH
jobs=${JOBS:-4}

usage() {
  cat <<'USAGE'
Usage: lab <command> [args]

  host-setup [args]           Install and configure the prerequisites on this machine
                              (packages, libvirt, pools, OpenTofu). Args go to ansible-playbook,
                              e.g. --check or --ask-become-pass.
  image build [--force] [name ...]
                              Download Linux images (images/linux.yml) and build Windows
                              images (images/windows.yml). By default all images are built;
                              images whose inputs are unchanged are skipped, and --force
                              builds a new image anyway (run this before "up").
  image list                  List base images in lab-base.
  up [limit]                  Create VMs and wait until they accept connections.
  provision [limit] [args]    Run playbooks/main.yml.
  stop [limit] [--force]      Shut the VMs down (--force powers them off).
  destroy [limit] [--force]   Delete the VMs and their disks (--force skips the prompt).
  status                      List lab VMs.
  hosts                       List inventory hosts (with their image) and groups.
  image prune [--delete]      List (or delete) old base images that no disk uses.

USAGE
}

existing_vms() {
  local names
  names=$(virsh -c qemu:///system list --all --name | sed -n 's/^lab-//p' | paste -sd, -)
  [ -n "$names" ] || { echo "No lab VMs exist." >&2; return 1; }
  echo "$names"
}

resolve_hosts() {
  local hosts
  hosts=$(ansible all -i inventory/inventory.py -l "$1" --list-hosts 2>/dev/null | tail -n +2 | tr -d ' ')
  [ -n "$hosts" ] || { echo "No hosts match \"$1\". Run \"lab hosts\" to list hosts and groups." >&2; return 1; }
  echo "$hosts"
}

ensure_key() {
  [ -f .lab/ssh/id_ed25519 ] || { mkdir -p .lab/ssh && ssh-keygen -q -t ed25519 -N '' -C kvm-lab -f .lab/ssh/id_ed25519; }
}

ensure_networks() {
  local nets h
  nets=$(for h in $1; do inventory/inventory.py --host "$h" | jq -r '.attached_networks[]'; done | sort -u | jq -R . | jq -sc .)
  ansible-playbook playbooks/libvirt-host-network.yml -e "{\"libvirt_host_network_names\": $nets}"
}

vm_each() {
  printf '%s\n' "$2" | xargs -P "$jobs" -I{} scripts/lab-vm.sh "$1" {}
}

cmd=${1:-}
[ $# -eq 0 ] || shift

case $cmd in
  host-setup) exec ansible-playbook playbooks/host-setup.yml "$@" ;;
  up)
    limit=${1:-all}
    hosts=$(resolve_hosts "$limit") || exit 1
    ensure_key
    ensure_networks "$hosts"
    vm_each up "$hosts"
    exec ansible-playbook playbooks/lab-ready.yml -l "$limit"
    ;;
  provision)
    limit=${1:-all}
    [ $# -eq 0 ] || shift
    exec ansible-playbook playbooks/main.yml -l "$limit" "$@"
    ;;
  stop)
    limit=""
    case ${1:-} in "" | --*) ;; *) limit=$1; shift ;; esac
    [ -n "$limit" ] || limit=$(existing_vms) || exit 0
    case ${1:-} in
      "") ;;
      --force) export FORCE=1 ;;
      *) usage >&2; exit 2 ;;
    esac
    hosts=$(resolve_hosts "$limit") || exit 1
    vm_each stop "$hosts"
    ;;
  destroy)
    limit=""
    force=0
    case ${1:-} in "" | --*) ;; *) limit=$1; shift ;; esac
    case ${1:-} in
      "") ;;
      --force) force=1 ;;
      *) usage >&2; exit 2 ;;
    esac
    if [ -z "$limit" ]; then
      limit=$(existing_vms) || exit 0
      if [ "$force" = 0 ]; then
        echo "This will delete the VMs and their disks: ${limit//,/ }"
        read -r -p "Continue? [y/N] " answer
        [ "$answer" = y ] || [ "$answer" = Y ] || { echo "Cancelled."; exit 1; }
      fi
    fi
    hosts=$(resolve_hosts "$limit") || exit 1
    vm_each destroy "$hosts"
    ;;
  status) virsh -c qemu:///system list --all | grep -E ' Name |lab-' || true ;;
  hosts)
    exec python3 -I - <<'PY'
import json, subprocess
d = json.loads(subprocess.check_output(["inventory/inventory.py", "--list"]))
hosts = d["_meta"]["hostvars"]
print("Hosts (name, image):")
for name, v in sorted(hosts.items()):
    print(f"  {name:28} {v.get('image', '')}")
print("Groups:")
for g, v in sorted(d.items()):
    if g not in ("_meta", "all") and v.get("hosts"):
        print(f"  {g:28} {len(v['hosts'])} hosts")
PY
    ;;
  image)
    sub=${1:-}
    [ $# -eq 0 ] || shift
    case $sub in
      list) exec virsh -c qemu:///system vol-list --pool "${LAB_BASE_POOL:-lab-base}" ;;
      build)
        force=0
        names=()
        for arg in "$@"; do
          if [ "$arg" = --force ]; then force=1; else names+=("$arg"); fi
        done
        known=$(python3 -I - images/linux.yml images/windows.yml <<'PY'
import sys, yaml
for kind, path in (("linux", sys.argv[1]), ("windows", sys.argv[2])):
    for key in yaml.safe_load(open(path))["images"]:
        print(kind, key)
PY
)
        [ ${#names[@]} -gt 0 ] || mapfile -t names < <(awk '{print $2}' <<<"$known")
        for name in "${names[@]}"; do
          kind=$(awk -v n="$name" '$2 == n {print $1}' <<<"$known")
          [ "$kind" = linux ] || [ "$kind" = windows ] || { echo "Unknown image: $name" >&2; exit 2; }
          args=("$name")
          [ "$force" = 0 ] || args=(--force "$name")
          "scripts/image-build-$kind.sh" "${args[@]}"
        done
        ;;
      prune) exec scripts/image-prune.sh "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
